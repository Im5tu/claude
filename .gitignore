# Ignore everything by default
**/*

# Standard repo files
!.gitignore
!.gitattributes
!LICENSE
!README.md
!CLAUDE.md

# Settings (exclude credentials)
!settings.json
.credentials.json

# Tracked directories and contents
!agents/
!agents/**
!commands/
!commands/**
!skills/
!skills/**
# Present on disk (symlinked into ~/.claude) but NOT part of this config:
# separately-distributed Claude Ads bundle
skills/ads/
skills/ads-google/
agents/audit-*.md
agents/format-adapter.md
agents/release-verifier.md
agents/research-worker.md
agents/skill-reviewer.md
agents/source-verifier.md

# Machine-local, referenced by CLAUDE.md via @RTK.md
RTK.md

# Hooks referenced by settings.json / CLAUDE.md
!hooks/
!hooks/**
