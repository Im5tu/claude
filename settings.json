{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet publish:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(rustfmt:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "stripe@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "auto",
  "verbose": false,
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name // \"?\"'); pct=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$pct\" ]; then printf '%s | ctx %.0f%%' \"$model\" \"$pct\"; else printf '%s' \"$model\"; fi"
  }
}
