{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "8",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet publish:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(rustfmt:*)"
    ],
    "deny": [
      "PowerShell"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Users/stuar/.claude/hooks/block-foreground-sleep.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name // \"?\"'); pct=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$pct\" ]; then printf '%s | ctx %.0f%%' \"$model\" \"$pct\"; else printf '%s' \"$model\"; fi"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "csharp-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": false,
    "stripe@claude-plugins-official": false
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh",
      "autoCompactWindow": 500000
    },
    "claude-sonnet-5-5": {
      "autoCompactWindow": 500000
    },
    "claude-haiku-5-5": {
      "autoCompactWindow": 100000
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "theme": "auto",
  "verbose": false,
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
